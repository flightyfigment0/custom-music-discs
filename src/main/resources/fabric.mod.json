{
	"schemaVersion": 1,
	"id": "custom-music-discs",
	"version": "${version}",
	"name": "Custom Music Discs",
	"description": "Custom music discs for servers: upload audio to the web uploader, run /discs reload, and grab disc items with /getdisc. Works for all players, no operator permissions needed.",
	"authors": [
		"aiden"
	],
	"contact": {
		"homepage": "https://github.com/",
		"sources": "https://github.com/"
	},
	"license": "MIT",
	"icon": "assets/custom-music-discs/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.custommusicdiscs.CustomMusicDiscs"
		],
		"client": [
			"com.custommusicdiscs.client.CustomMusicDiscsClient"
		]
	},
	"mixins": [
		{
			"config": "custommusicdiscs.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
